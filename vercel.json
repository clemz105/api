{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap.js",
      "headers": {
        "Content-Type": "application/xml"
      }
    },
    {
      "src": "/sitemap-pages.xml",
      "dest": "/api/sitemap.js",
      "headers": {
        "Content-Type": "application/xml"
      }
    },
    {
      "src": "/sitemap-products.xml",
      "dest": "/api/sitemap.js",
      "headers": {
        "Content-Type": "application/xml"
      }
    },
    {
      "src": "/sitemap-countries.xml",
      "dest": "/api/sitemap-countries.js",
      "headers": {
        "Content-Type": "application/xml"
      }
    },
    {
      "src": "/sitemap-ads.xml",
      "dest": "/api/sitemap-ads.js",
      "headers": {
        "Content-Type": "application/xml"
      }
    }
  ]
}
