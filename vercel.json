{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/sitemap.xml", "dest": "/api/sitemap.js" },
    { "src": "/sitemap-pages.xml", "dest": "/api/sitemap.js" },
    { "src": "/sitemap-products.xml", "dest": "/api/sitemap.js" },
    { "src": "/sitemap-countries.xml", "dest": "/api/sitemap-countries.js" },
    { "src": "/sitemap-ads.xml", "dest": "/api/sitemap-ads.js" }
  ],
  "headers": [
    {
      "source": "/sitemap.*\\.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    }
  ]
}
